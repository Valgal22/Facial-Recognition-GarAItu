    {
        "id": "dc378ae81abfcc21",
        "type": "function",
        "z": "tab_memorylens",
        "g": "group_auth",
        "name": "Bridge: GET to POST & Headers",
        "func": "// 1. Construimos la URL correcta para el Backend\nmsg.url = \"http://localhost:8080/garAItu/group/\" + msg.req.params.id + \"/invite\";\n\n// 2. Traducimos el GET del móvil a un POST para el Servidor\nmsg.method = \"POST\";\n\n// 3. Forward de la sesión\nmsg.headers = {\n    \"X-Session-Id\": msg.req.headers[\"x-session-id\"]\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 600,
        "wires": [
