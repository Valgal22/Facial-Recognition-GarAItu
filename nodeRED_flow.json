    {
        "id": "3397b98f71e3f23d",
        "type": "function",
        "z": "tab_memorylens",
        "g": "group_patient",
        "name": "ValidateScore (>=0.5 → Uniface)",
        "func": "const TH = flow.get('face_threshold') ?? 0.5;\nconst p = msg.payload || {};\nconst score = Number(p.score);\n\nif (Number.isNaN(score)) {\n    msg.error = { code: 'NO_SCORE', message: 'Missing/invalid score' };\n    msg.status = 400;\n    return [null, msg];\n}\n\nmsg.metrics = {\n    first_model_score: score,\n    threshold: TH\n};\n\nif (score >= TH) {\n    msg.route = 'to_uniface';\n    return [msg, null];\n}\n\nmsg.route = 'skip_uniface';\nmsg.result = {\n    recognized: false,\n    reason: 'score_below_threshold',\n    score\n};\nmsg.status = 200;\nreturn [null, msg];\n",
        "outputs": 2,
