    {
        "id": "a38eed1b4763d9ba",
        "type": "function",
        "z": "tab_memorylens",
        "g": "group_patient",
        "name": "Prepare Multipart",
        "func": "if (msg.req.files && msg.req.files.length > 0) {\n    var file = msg.req.files[0];\n    \n    // 1. Extraer Auth y Params\n    // groupId viene en el cuerpo del multipart (msg.req.body) porque 'http in' de Node-RED parsea los campos de texto ahí.\n    msg.group_id = (msg.req.body && msg.req.body.groupId) ? msg.req.body.groupId : \"default\";\n    msg.session_id = msg.req.headers['x-session-id'];\n    \n    // Guardar los datos originales de la imagen para recuperarlos después de /detect\n    msg.original_image_data = {\n        buffer: file.buffer,\n        filename: file.originalname,\n        mimetype: file.mimetype\n    };\n    \n    msg.payload = {\n        \"image\": {\n            \"value\": file.buffer,\n            \"options\": {\n                \"filename\": file.originalname,\n                \"contentType\": file.mimetype\n            }\n        }\n    };\n    msg.headers = {};\n    msg.headers['content-type'] = 'multipart/form-data';\n} else {\n    msg.payload = {};\n}\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 2340,
        "wires": [
            [
                "d779c26e3cc1e768",
                "7e8bc1698f96f787"
            ]
        ]
    },
