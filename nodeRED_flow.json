        "g": "group_family",
        "name": "Prepare Upload Params",
        "func": "if (msg.req.files && msg.req.files.length > 0) {\n    const file = msg.req.files[0];\n\n    msg.member_id = msg.req.body?.id || null;\n    msg.session_id = msg.req.headers['x-session-id'];\n\n    if (!msg.member_id) {\n        msg.payload = { error: \"Missing member 'id' in multipart body\" };\n        msg.statusCode = 400;\n        msg._responded = true;\n        return [null, msg];\n    }\n\n    if (!msg.session_id) {\n        msg.payload = { error: \"Missing 'X-Session-Id' header\" };\n        msg.statusCode = 400;\n        msg._responded = true;\n        return [null, msg];\n    }\n\n    msg.original_image_data = {\n        buffer: file.buffer,\n        filename: file.originalname,\n        mimetype: file.mimetype\n    };\n\n    msg.payload = {\n        image: {\n            value: file.buffer,\n            options: {\n                filename: file.originalname,\n                contentType: file.mimetype\n            }\n        }\n    };\n\n    msg.headers = { 'content-type': 'multipart/form-data' };\n    return [msg, null];\n}\n\nmsg.payload = { error: \"No file uploaded\" };\nmsg.statusCode = 400;\nmsg._responded = true;\nreturn [null, msg];",
