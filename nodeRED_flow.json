    {
        "id": "a5cf70cef51860af",
        "type": "function",
        "z": "tab_memorylens",
        "g": "group_patient",
        "name": "Format Response",
        "func": "// Normaliza la respuesta del microservicio\nconst t = msg._t0 || Date.now();\nconst latency = Date.now() - t;\nconst resp = msg.payload || {};\nconst pf = resp.primary_face || {};\nlet embeddingBase64 = null;\nif (resp.embedding && Array.isArray(resp.embedding)) {\n    const floatArray = new Float32Array(resp.embedding);\n    const buffer = Buffer.from(floatArray.buffer);\n    embeddingBase64 = buffer.toString('base64');\n}\n\n// 2. Configurar llamada REST\nif (embeddingBase64) {\n    msg.payload = {\n        embeddingBase64: embeddingBase64,\n        minSim: 0.4,\n        top: 5\n    };\n    \n    // Headers\n    msg.headers = {};\n    msg.headers['Content-Type'] = 'application/json';\n    if (msg.session_id) {\n        msg.headers['X-Session-Id'] = msg.session_id;\n    }\n    \n    // URL endpoint Java\n    msg.url = `http://localhost:8080/garAItu/group/${msg.group_id}/recognize`;\n    \n    msg.metrics = msg.metrics || {};\n    msg.metrics.uniface_latency_ms = latency;\n    msg.local_result = { recognized: !!resp.recognized, primary_face: pf };\n\n    // SALIDA 1: Al REST\n    return [msg, null];\n} else {\n    // Si no hubo cara, no llamamos al REST. Respondemos directo.\n    msg.payload = { recognized: false, reason: \"No embedding generated\" };\n    \n    msg.metrics = msg.metrics || {};\n    msg.metrics.uniface_latency_ms = latency;\n    msg.local_result = { recognized: false, primary_face: pf };\n    \n    // SALIDA 2: Directo a Response\n    return [null, msg];\n}",
